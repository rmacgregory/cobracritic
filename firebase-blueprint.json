        "displayName",
        "photoURL",
        "status",
        "rejectionReason",
        "reviewedBy",
        "reviewedByName",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public group profiles for approved members (no PII)."
    },
    "/accessRequests/{userId}": {
      "schema": { "$ref": "#/entities/AccessRequest" },
      "description": "New user access requests awaiting admin approval or rejection. Deterministic ID equals requester UID."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Delegated admin privileges managed exclusively by existing admins."
    },
    "/bans/{userId}": {
      "schema": { "$ref": "#/entities/UserBan" },
      "description": "Banned user records managed exclusively by admins."
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/Game" },
      "description": "Manually registered games catalog for the friend group."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Friend ratings (0-100) and critiques. Deterministic ID {gameId}_{authorId} enforces one review per friend per game."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/ReviewComment" },
      "description": "Social comments posted by friends on reviews."
    },
    "/reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/ReviewReaction" },
      "description": "Friend agreement reactions on reviews. Deterministic ID {reviewId}_{userId}."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Admin-managed awards and voting events with categories, nominated games, mode, deadline, and winners."
    },
    "/eventVotes/{voteId}": {
      "schema": { "$ref": "#/entities/EventVote" },
      "description": "Public member votes per event category. Deterministic ID {eventId}_{categoryId}_{userId} enforces one vote per member per category."
    },
    "/eventNominations/{nominationId}": {
      "schema": { "$ref": "#/entities/EventNomination" },
      "description": "Single game nomination per member during an event's nominating phase. Deterministic ID {eventId}_{userId}."
    },
    "/userGameStatuses/{statusId}": {
      "schema": { "$ref": "#/entities/UserGameStatus" },
      "description": "Member play status per catalog game. Deterministic ID {gameId}_{userId}."
    },
    "/groupConfig/{configId}": {
      "schema": { "$ref": "#/entities/FeaturedRoundConfig" },
      "description": "Admin-managed shared group settings: featuredRound (FeaturedRoundConfig)."
    },
    "/coverReports/{reportId}": {
      "schema": { "$ref": "#/entities/CoverReport" },
      "description": "Incorrect cover art reports sent by members to administrators. Deterministic ID {gameId}_{reporterId}."
    }
  }
}
