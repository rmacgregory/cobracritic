{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile of a friend in the review group (strictly non-PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the member."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Public display name shown on reviews and comments."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 65000,
          "description": "Optional HTTPS avatar URL or 300x300 cropped JPEG/WebP data URI."
        },
        "bio": {
          "type": "string",
          "maxLength": 240,
          "description": "Short gaming profile bio."
        },
        "topFiveGames": {
          "type": "array",
          "description": "Member's Top 5 all-time favorite games (0 to 5 strings, max 120 chars each)."
        },
        "notificationPreferences": {
          "type": "object",
          "description": "Optional per-user notification toggles (comments, mentions, featuredRound, events, coverReports, liveToasts booleans)."
        },
        "memberBadge": {
          "type": "string",
          "enum": ["cobra", "guest"],
          "description": "Admin-managed user badge differentiating 'cobra' (Membro dos Cobras) from 'guest' (Convidado). Defaults to 'cobra' when omitted."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group-shared visibility scope."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "bio",
        "topFiveGames",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "Game": {
      "title": "Game",
      "description": "A manually registered video game in the friends' shared catalog.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Game title."
        },
        "developer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Game studio or developer."
        },
        "releaseDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Release date in YYYY-MM-DD format."
        },
        "releaseYear": {
          "type": "number",
          "description": "Release year (1970 to 2035) for quick filtering."
        },
        "platforms": {
          "type": "array",
          "description": "List of platforms (1 to 8 items)."
        },
        "genres": {
          "type": "array",
          "description": "List of genres (1 to 5 items)."
        },
        "synopsis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "description": "Short game synopsis or notes."
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Local preset artwork path or external HTTPS image URL."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the friend who registered the game."
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the friend who registered the game."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group-shared visibility scope."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of game registration."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last game edit."
        }
      },
      "required": [
        "title",
        "developer",
        "releaseDate",
        "releaseYear",
        "platforms",
        "genres",
        "synopsis",
        "coverUrl",
        "createdBy",
        "createdByName",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "A Metacritic-style score (0-100) and written critique from a friend for a registered game.",
      "type": "object",
      "properties": {
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference ID of the reviewed game."
        },
        "gameTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Denormalized game title for feed rendering."
        },
        "gameCoverUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Denormalized cover URL for feed rendering."
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the reviewer."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the reviewer."
        },
        "authorPhotoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar URL of the reviewer."
        },
        "score": {
          "type": "number",
          "description": "Integer score from 0 to 100."
        },
        "ratingOnly": {
          "type": "boolean",
          "description": "True when the member chose to submit only a numeric score without writing a critique."
        },
        "hasSpoiler": {
          "type": "boolean",
          "description": "True when the written critique contains story or gameplay spoilers and should be veiled by default."
        },
        "headline": {
          "type": "string",
          "minLength": 0,
          "maxLength": 140,
          "description": "Short verdict title for the review (empty when ratingOnly is true, 2..140 chars otherwise)."
        },
        "body": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000,
          "description": "Full written critique (empty when ratingOnly is true, 10..4000 chars otherwise)."
        },
        "platformPlayed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Platform on which the friend played the game."
        },
        "hoursPlayed": {
          "type": "number",
          "description": "Approximate hours played (0 to 10000)."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group-shared visibility scope."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of publication."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "gameId",
        "gameTitle",
        "gameCoverUrl",
        "authorId",
        "authorName",
        "authorPhotoURL",
        "score",
        "headline",
        "body",
        "platformPlayed",
        "hoursPlayed",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReviewComment": {
      "title": "ReviewComment",
      "description": "A social comment posted by a friend on another friend's review.",
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference ID of the parent review."
        },
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference ID of the associated game."
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the commenter."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the commenter."
        },
        "authorPhotoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar URL of the commenter."
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Comment text."
        },
        "parentCommentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Optional ID of the root parent comment when this comment is a threaded reply."
        },
        "replyToAuthorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Optional display name of the member being replied to inside the thread."
        },
        "hasSpoiler": {
          "type": "boolean",
          "description": "True when the comment contains spoilers and should be veiled until revealed."
        },
        "mentionedUserIds": {
          "type": "array",
          "description": "Optional bounded list (0 to 8) of UIDs mentioned via @member in this comment."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group-shared visibility scope."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of comment creation."
        }
      },
      "required": [
        "reviewId",
        "gameId",
        "authorId",
        "authorName",
        "authorPhotoURL",
        "body",
        "visibility",
        "createdAt"
      ]
    },
    "ReviewReaction": {
      "title": "ReviewReaction",
      "description": "A friend's agreement reaction on a review in the social feed.",
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference ID of the reacted review."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the friend reacting."
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the friend reacting."
        },
        "type": {
          "type": "string",
          "enum": ["agree"],
          "description": "Type of reaction."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group-shared visibility scope."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of reaction."
        }
      },
      "required": [
        "reviewId",
        "userId",
        "userName",
        "type",
        "visibility",
        "createdAt"
      ]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Delegated admin privilege grant for a group member.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the member granted admin privileges."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display label of the admin member."
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Delegated role identifier."
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who granted this role."
        },
        "grantedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the admin who granted this role."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group-shared visibility scope."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of role grant."
        }
      },
      "required": [
        "uid",
        "displayName",
        "role",
        "grantedBy",
        "grantedByName",
        "visibility",
        "createdAt"
      ]
    },
    "UserBan": {
      "title": "UserBan",
      "description": "Moderation ban record blocking a member from writing or interacting in the group.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the banned member."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the banned member."
        },
        "reason": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional moderation reason for the ban."
        },
        "bannedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who issued the ban."
        },
        "bannedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the admin who issued the ban."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group-shared visibility scope."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of ban creation."
        }
      },
      "required": [
        "uid",
        "displayName",
        "reason",
        "bannedBy",
        "bannedByName",
        "visibility",
        "createdAt"
      ]
    },
    "Event": {
      "title": "Event",
      "description": "Group awards or prediction event with admin-managed categories, nominated games, active/inactive/closed lifecycle, and official winners.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Event name."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional event description or rules."
        },
        "mode": {
          "type": "string",
          "enum": ["poll", "award"],
          "description": "Event mode: poll (highest voted wins) or award (admin picks official live winners and scores member predictions)."
        },
        "deadlineAt": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional ISO local deadline string (YYYY-MM-DDTHH:mm) for countdown display."
        },
        "status": {
          "type": "string",
          "enum": ["nominating", "active", "inactive", "closed"],
          "description": "Lifecycle status: nominating (members nominate 1 game), active (voting open), inactive (paused/draft), closed (winners declared)."
        },
        "categories": {
          "type": "array",
          "description": "Bounded list (0 to 30) of event categories containing nominated games and optional winnerNomineeId."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who created the event."
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the admin who created the event."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group-shared visibility scope."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of event creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last event update."
        }
      },
      "required": [
        "title",
        "description",
        "status",
        "categories",
        "createdBy",
        "createdByName",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "EventVote": {
      "title": "EventVote",
      "description": "A member's public vote for a nominated game in a specific event category.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference ID of the parent event."
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifier of the category within the event."
        },
        "nomineeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifier of the nominated game voted for."
        },
        "nomineeTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Denormalized nominee game title."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the member casting the vote."
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the voting member."
        },
        "userPhotoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional HTTPS avatar URL of the voting member."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group-shared visibility scope."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of vote creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last vote update."
        }
      },
      "required": [
        "eventId",
        "categoryId",
        "nomineeId",
        "nomineeTitle",
        "userId",
        "userName",
        "userPhotoURL",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "CoverReport": {
      "title": "CoverReport",
      "description": "Report filed by a member when a game's cover art is incorrect or broken, routed to admins for review.",
      "type": "object",
      "properties": {
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference ID of the game with the incorrect cover."
        },
        "gameTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Denormalized title of the reported game."
        },
        "gameCoverUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Current cover URL at the time of the report."
        },
        "reporterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the member who reported the cover."
        },
        "reporterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the reporting member."
        },
        "reporterPhotoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional HTTPS avatar URL of the reporter."
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional note describing what is wrong with the cover."
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"],
          "description": "Report status managed by admins."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group scope identifier for query enforcement."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of report submission."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last status update."
        }
      },
      "required": [
        "gameId",
        "gameTitle",
        "gameCoverUrl",
        "reporterId",
        "reporterName",
        "reporterPhotoURL",
        "note",
        "status",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "EventNomination": {
      "title": "EventNomination",
