        "gameId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional catalog game ID (empty for manual title nomination)."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Nominated game title."
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional cover image URL."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the nominating member."
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the nominating member."
        },
        "userPhotoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional HTTPS avatar URL."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group scope identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of nomination creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "eventId",
        "gameId",
        "title",
        "coverUrl",
        "userId",
        "userName",
        "userPhotoURL",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserGameStatus": {
      "title": "UserGameStatus",
      "description": "Personal play status of a member for a catalog game (deterministic ID {gameId}_{userId}).",
      "type": "object",
      "properties": {
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference ID of the catalog game."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the member."
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the member."
        },
        "userPhotoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional HTTPS avatar URL."
        },
        "status": {
          "type": "string",
          "enum": ["playing", "completed", "platinum", "wishlist", "dropped"],
          "description": "Member play status for this game."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group scope identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of status creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of status update."
        }
      },
      "required": [
        "gameId",
        "userId",
        "userName",
        "userPhotoURL",
        "status",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "FeaturedRoundConfig": {
      "title": "FeaturedRoundConfig",
      "description": "Admin-pinned current Game of the Round highlighted at the top of the catalog and social feed.",
      "type": "object",
      "properties": {
        "gameId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional catalog game ID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Pinned game title."
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional cover URL."
        },
        "roundLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Label of the current round or event."
        },
        "eventId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional originating event ID."
        },
        "note": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional short note for the group."
        },
        "pinnedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who pinned the round game."
        },
        "pinnedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the admin."
        },
        "visibility": {
          "type": "string",
          "enum": ["group"],
          "description": "Group scope identifier."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update."
        }
      },
      "required": [
        "gameId",
        "title",
        "coverUrl",
        "roundLabel",
        "eventId",
        "note",
        "pinnedBy",
        "pinnedByName",
        "visibility",
        "updatedAt"
      ]
    },
    "AccessRequest": {
      "title": "AccessRequest",
      "description": "Pending, approved, or rejected membership access request submitted automatically when a new user signs in with Google without an existing /users profile. Deterministic ID is the requester UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the requester."
