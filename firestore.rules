rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Primitives
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isNotBanned() {
      return !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    function isMasterAdmin() {
      return isVerified() && request.auth.token.email == 'kaorurou@gmail.com';
    }

    function isAdmin() {
      return isMasterAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        isNotBanned()
      );
    }

    function isApprovedMember() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function canMemberWrite() {
      return (isAdmin() || (isVerified() && isApprovedMember())) && isNotBanned();
    }

    function isSafeOptionalUrl(url) {
      return url is string && url.size() <= 500 && (
        url == '' ||
        url.matches('^https://.*$') ||
        url.matches('^/src/assets/images/[a-zA-Z0-9_\\-\\.]+$')
      );
    }

    function isSafeAvatarUrl(url) {
      return url is string && (
        (url.size() <= 500 && (url == '' || url.matches('^https://.*$'))) ||
        (url.size() <= 65000 && url.matches('^data:image/(jpeg|webp);base64,[A-Za-z0-9+/=]+$'))
      );
    }

    function isValidTopFiveGames(list) {
      return list is list &&
        list.size() <= 5 &&
        (list.size() < 1 || (list[0] is string && list[0].size() >= 1 && list[0].size() <= 120)) &&
        (list.size() < 2 || (list[1] is string && list[1].size() >= 1 && list[1].size() <= 120)) &&
        (list.size() < 3 || (list[2] is string && list[2].size() >= 1 && list[2].size() <= 120)) &&
        (list.size() < 4 || (list[3] is string && list[3].size() >= 1 && list[3].size() <= 120)) &&
        (list.size() < 5 || (list[4] is string && list[4].size() >= 1 && list[4].size() <= 120));
    }

    function isValidEventCategorySample(cat) {
      return cat is map &&
        cat.keys().hasAll(['id', 'name', 'nominees', 'winnerNomineeId']) &&
        cat.keys().hasOnly(['id', 'name', 'nominees', 'winnerNomineeId']) &&
        isValidId(cat.id) &&
        cat.name is string && cat.name.size() >= 1 && cat.name.size() <= 100 &&
        cat.nominees is list && cat.nominees.size() <= 16 &&
        (cat.nominees.size() == 0 || (
          cat.nominees[0] is map &&
          cat.nominees[0].keys().hasAll(['id', 'gameId', 'title', 'coverUrl']) &&
          cat.nominees[0].keys().hasOnly(['id', 'gameId', 'title', 'coverUrl']) &&
          isValidId(cat.nominees[0].id) &&
          cat.nominees[0].gameId is string && cat.nominees[0].gameId.size() <= 128 &&
          cat.nominees[0].title is string && cat.nominees[0].title.size() >= 1 && cat.nominees[0].title.size() <= 120 &&
          isSafeOptionalUrl(cat.nominees[0].coverUrl)
        )) &&
        cat.winnerNomineeId is string && cat.winnerNomineeId.size() <= 128;
    }

    function isValidNotificationPreferences(prefs) {
      return prefs is map &&
        prefs.keys().hasAll([
          'comments', 'mentions', 'featuredRound', 'events', 'coverReports', 'liveToasts'
        ]) &&
        prefs.keys().hasOnly([
          'comments', 'mentions', 'featuredRound', 'events', 'coverReports', 'liveToasts'
        ]) &&
        prefs.comments is bool &&
        prefs.mentions is bool &&
        prefs.featuredRound is bool &&
        prefs.events is bool &&
        prefs.coverReports is bool &&
        prefs.liveToasts is bool;
    }

    // ---------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // ---------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'photoURL', 'bio', 'topFiveGames',
          'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'bio', 'topFiveGames', 'favoriteGenre',
          'notificationPreferences', 'memberBadge', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        isSafeAvatarUrl(data.photoURL) &&
        data.bio is string && data.bio.size() <= 240 &&
        isValidTopFiveGames(data.topFiveGames) &&
        (!('favoriteGenre' in data) || (data.favoriteGenre is string && data.favoriteGenre.size() <= 40)) &&
        (!('notificationPreferences' in data) || isValidNotificationPreferences(data.notificationPreferences)) &&
        (!('memberBadge' in data) || (data.memberBadge is string && data.memberBadge in ['cobra', 'guest'])) &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminGrant(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'role', 'grantedBy', 'grantedByName',
          'visibility', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'role', 'grantedBy', 'grantedByName',
          'visibility', 'createdAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.role is string && data.role == 'admin' &&
        isValidId(data.grantedBy) &&
        data.grantedBy == request.auth.uid &&
        data.grantedByName is string && data.grantedByName.size() >= 1 && data.grantedByName.size() <= 80 &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp;
    }

    function isValidUserBan(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'reason', 'bannedBy', 'bannedByName',
          'visibility', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'reason', 'bannedBy', 'bannedByName',
          'visibility', 'createdAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.reason is string && data.reason.size() <= 300 &&
        isValidId(data.bannedBy) &&
        data.bannedBy == request.auth.uid &&
        data.bannedByName is string && data.bannedByName.size() >= 1 && data.bannedByName.size() <= 80 &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp;
    }

    function isValidGame(data) {
      return data.keys().hasAll([
          'title', 'developer', 'releaseDate', 'releaseYear',
          'platforms', 'genres', 'synopsis', 'coverUrl',
          'createdBy', 'createdByName', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'developer', 'releaseDate', 'releaseYear',
          'platforms', 'genres', 'synopsis', 'coverUrl',
          'createdBy', 'createdByName', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.developer is string && data.developer.size() >= 1 && data.developer.size() <= 100 &&
        data.releaseDate is string && data.releaseDate.size() == 10 &&
        data.releaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.releaseYear is int && data.releaseYear >= 1970 && data.releaseYear <= 2035 &&
        data.platforms is list && data.platforms.size() >= 1 && data.platforms.size() <= 8 &&
        data.platforms[0] is string && data.platforms[0].size() >= 1 && data.platforms[0].size() <= 40 &&
        data.genres is list && data.genres.size() >= 1 && data.genres.size() <= 5 &&
        data.genres[0] is string && data.genres[0].size() >= 1 && data.genres[0].size() <= 40 &&
        data.synopsis is string && data.synopsis.size() >= 1 && data.synopsis.size() <= 1200 &&
        isSafeOptionalUrl(data.coverUrl) &&
        isValidId(data.createdBy) &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80 &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'gameId', 'gameTitle', 'gameCoverUrl', 'authorId', 'authorName', 'authorPhotoURL',
          'score', 'headline', 'body', 'platformPlayed', 'hoursPlayed',
          'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'gameId', 'gameTitle', 'gameCoverUrl', 'authorId', 'authorName', 'authorPhotoURL',
          'score', 'ratingOnly', 'hasSpoiler', 'headline', 'body', 'platformPlayed', 'hoursPlayed',
          'visibility', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.gameId) &&
        data.gameTitle is string && data.gameTitle.size() >= 1 && data.gameTitle.size() <= 120 &&
        isSafeOptionalUrl(data.gameCoverUrl) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        isSafeOptionalUrl(data.authorPhotoURL) &&
        data.score is int && data.score >= 0 && data.score <= 100 &&
        (!('ratingOnly' in data) || data.ratingOnly is bool) &&
        (!('hasSpoiler' in data) || data.hasSpoiler is bool) &&
        data.headline is string && data.headline.size() <= 140 &&
        data.body is string && data.body.size() <= 4000 &&
        (
          ('ratingOnly' in data && data.ratingOnly == true && data.headline == '' && data.body == '') ||
          (data.headline.size() >= 2 && data.body.size() >= 10)
        ) &&
        data.platformPlayed is string && data.platformPlayed.size() >= 1 && data.platformPlayed.size() <= 40 &&
        data.hoursPlayed is number && data.hoursPlayed >= 0 && data.hoursPlayed <= 10000 &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll([
          'reviewId', 'gameId', 'authorId', 'authorName', 'authorPhotoURL',
          'body', 'visibility', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'reviewId', 'gameId', 'authorId', 'authorName', 'authorPhotoURL',
          'body', 'parentCommentId', 'replyToAuthorName', 'hasSpoiler', 'mentionedUserIds',
          'visibility', 'createdAt'
        ]) &&
        isValidId(data.reviewId) &&
        isValidId(data.gameId) &&
        isValidId(data.authorId) &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        isSafeOptionalUrl(data.authorPhotoURL) &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
        (!('parentCommentId' in data) || isValidId(data.parentCommentId)) &&
        (!('replyToAuthorName' in data) || (
          'parentCommentId' in data &&
          data.replyToAuthorName is string &&
          data.replyToAuthorName.size() >= 1 &&
          data.replyToAuthorName.size() <= 80
        )) &&
        (!('hasSpoiler' in data) || data.hasSpoiler is bool) &&
        (!('mentionedUserIds' in data) || (
          data.mentionedUserIds is list &&
          data.mentionedUserIds.size() <= 8 &&
          (data.mentionedUserIds.size() == 0 || isValidId(data.mentionedUserIds[0]))
        )) &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp;
    }

    function isValidReaction(data) {
      return data.keys().hasAll([
          'reviewId', 'userId', 'userName', 'type', 'visibility', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'reviewId', 'userId', 'userName', 'type', 'visibility', 'createdAt'
        ]) &&
        isValidId(data.reviewId) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.type is string && data.type == 'agree' &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp;
    }

    function isValidEvent(data) {
      return data.keys().hasAll([
          'title', 'description', 'status', 'categories',
          'createdBy', 'createdByName', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'description', 'mode', 'deadlineAt', 'status', 'categories',
          'createdBy', 'createdByName', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.description is string && data.description.size() <= 500 &&
        (!('mode' in data) || (data.mode is string && data.mode in ['poll', 'award'])) &&
        (!('deadlineAt' in data) || (
          data.deadlineAt is string &&
          data.deadlineAt.size() <= 32 &&
          (data.deadlineAt == '' || data.deadlineAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$'))
        )) &&
        data.status is string && data.status in ['nominating', 'active', 'inactive', 'closed'] &&
        data.categories is list && data.categories.size() <= 30 &&
        (data.categories.size() == 0 || isValidEventCategorySample(data.categories[0])) &&
        isValidId(data.createdBy) &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80 &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEventVote(data) {
      return data.keys().hasAll([
          'eventId', 'categoryId', 'nomineeId', 'nomineeTitle',
          'userId', 'userName', 'userPhotoURL', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'eventId', 'categoryId', 'nomineeId', 'nomineeTitle',
          'userId', 'userName', 'userPhotoURL', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.eventId) &&
        isValidId(data.categoryId) &&
        isValidId(data.nomineeId) &&
        data.nomineeTitle is string && data.nomineeTitle.size() >= 1 && data.nomineeTitle.size() <= 120 &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        isSafeOptionalUrl(data.userPhotoURL) &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEventNomination(data) {
      return data.keys().hasAll([
          'eventId', 'gameId', 'title', 'coverUrl',
          'userId', 'userName', 'userPhotoURL', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'eventId', 'gameId', 'title', 'coverUrl',
          'userId', 'userName', 'userPhotoURL', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.eventId) &&
        data.gameId is string && data.gameId.size() <= 128 &&
        (data.gameId == '' || isValidId(data.gameId)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        isSafeOptionalUrl(data.coverUrl) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        isSafeOptionalUrl(data.userPhotoURL) &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserGameStatus(data) {
      return data.keys().hasAll([
          'gameId', 'userId', 'userName', 'userPhotoURL', 'status',
          'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'gameId', 'userId', 'userName', 'userPhotoURL', 'status',
          'visibility', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.gameId) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        isSafeOptionalUrl(data.userPhotoURL) &&
        data.status is string && data.status in ['playing', 'completed', 'platinum', 'wishlist', 'dropped'] &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFeaturedRoundConfig(data) {
      return data.keys().hasAll([
          'gameId', 'title', 'coverUrl', 'roundLabel', 'eventId', 'note',
          'pinnedBy', 'pinnedByName', 'visibility', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'gameId', 'title', 'coverUrl', 'roundLabel', 'eventId', 'note',
          'pinnedBy', 'pinnedByName', 'visibility', 'updatedAt'
        ]) &&
        data.gameId is string && data.gameId.size() <= 128 &&
        (data.gameId == '' || isValidId(data.gameId)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        isSafeOptionalUrl(data.coverUrl) &&
        data.roundLabel is string && data.roundLabel.size() >= 1 && data.roundLabel.size() <= 80 &&
        data.eventId is string && data.eventId.size() <= 128 &&
        (data.eventId == '' || isValidId(data.eventId)) &&
        data.note is string && data.note.size() <= 240 &&
        isValidId(data.pinnedBy) &&
        data.pinnedBy == request.auth.uid &&
        data.pinnedByName is string && data.pinnedByName.size() >= 1 && data.pinnedByName.size() <= 80 &&
        data.visibility is string && data.visibility == 'group' &&
        data.updatedAt is timestamp;
    }

    function isValidAccessRequest(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'photoURL', 'status', 'rejectionReason',
          'reviewedBy', 'reviewedByName', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'status', 'rejectionReason',
          'reviewedBy', 'reviewedByName', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        isSafeOptionalUrl(data.photoURL) &&
        data.status is string && data.status in ['pending', 'approved', 'rejected'] &&
        data.rejectionReason is string && data.rejectionReason.size() <= 300 &&
        data.reviewedBy is string && data.reviewedBy.size() <= 128 &&
        (data.reviewedBy == '' || isValidId(data.reviewedBy)) &&
        data.reviewedByName is string && data.reviewedByName.size() <= 80 &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCoverReport(data) {
      return data.keys().hasAll([
          'gameId', 'gameTitle', 'gameCoverUrl', 'reporterId', 'reporterName',
          'reporterPhotoURL', 'note', 'status', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'gameId', 'gameTitle', 'gameCoverUrl', 'reporterId', 'reporterName',
          'reporterPhotoURL', 'note', 'status', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.gameId) &&
        data.gameTitle is string && data.gameTitle.size() >= 1 && data.gameTitle.size() <= 120 &&
        isSafeOptionalUrl(data.gameCoverUrl) &&
        isValidId(data.reporterId) &&
        data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80 &&
        isSafeOptionalUrl(data.reporterPhotoURL) &&
        data.note is string && data.note.size() <= 300 &&
        data.status is string && data.status in ['open', 'resolved'] &&
        data.visibility is string && data.visibility == 'group' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection: /users/{userId} (Public Non-PII Member Profiles)
    // ---------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            userId == request.auth.uid &&
            !('memberBadge' in incoming()) &&
            isVerified() &&
            isNotBanned() &&
            exists(/databases/$(database)/documents/accessRequests/$(userId)) &&
            get(/databases/$(database)/documents/accessRequests/$(userId)).data.status == 'approved'
          )
        );
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'bio', 'topFiveGames', 'favoriteGenre',
              'notificationPreferences', 'updatedAt'
            ]) &&
            canMemberWrite()
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'memberBadge', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // Collection: /accessRequests/{userId} (Admin-Approved New User Onboarding)
    // Deterministic ID: {requesterUid}
    // ---------------------------------------------------------
    match /accessRequests/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isVerified() &&
        isNotBanned() &&
        !exists(/databases/$(database)/documents/users/$(userId)) &&
        isValidAccessRequest(incoming(), userId) &&
        incoming().status == 'pending' &&
        incoming().rejectionReason == '' &&
        incoming().reviewedBy == '' &&
        incoming().reviewedByName == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidAccessRequest(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().reviewedBy == request.auth.uid &&
            incoming().reviewedByName.size() >= 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'rejectionReason', 'reviewedBy', 'reviewedByName', 'updatedAt'
            ])
          ) ||
          (
            userId == request.auth.uid &&
            isVerified() &&
            isNotBanned() &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() &&
        isValidId(userId) &&
        (isAdmin() || (userId == request.auth.uid && existing().status == 'pending'));
    }

    // ---------------------------------------------------------
    // Collection: /admins/{userId} (Delegated Admin Roles)
    // ---------------------------------------------------------
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (resource == null || existing().visibility == 'group');
      allow list: if isSignedIn() && resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidAdminGrant(incoming(), userId) &&
        incoming().createdAt == request.time &&
        isAdmin() &&
        !exists(/databases/$(database)/documents/bans/$(userId));
      allow update: if false;
      allow delete: if isSignedIn() &&
        isValidId(userId) &&
        userId != request.auth.uid &&
        isAdmin();
    }

    // ---------------------------------------------------------
    // Collection: /bans/{userId} (Banned Member Records)
    // ---------------------------------------------------------
    match /bans/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (resource == null || existing().visibility == 'group');
      allow list: if isSignedIn() && resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        userId != request.auth.uid &&
        isValidUserBan(incoming(), userId) &&
        incoming().createdAt == request.time &&
        isAdmin() &&
        !exists(/databases/$(database)/documents/admins/$(userId));
      allow update: if false;
      allow delete: if isSignedIn() &&
        isValidId(userId) &&
        isAdmin();
    }

    // ---------------------------------------------------------
    // Collection: /games/{gameId} (Manually Registered Games)
    // ---------------------------------------------------------
    match /games/{gameId} {
      allow get: if isValidId(gameId) && (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(gameId) &&
        isValidGame(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canMemberWrite();
      allow update: if isSignedIn() &&
        isValidId(gameId) &&
        isValidGame(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canMemberWrite() &&
        (
          (existing().createdBy == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'developer', 'releaseDate', 'releaseYear',
              'platforms', 'genres', 'synopsis', 'coverUrl', 'updatedAt'
            ])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'developer', 'releaseDate', 'releaseYear',
              'platforms', 'genres', 'synopsis', 'coverUrl', 'updatedAt'
            ]))
        );
      allow delete: if isSignedIn() &&
        isValidId(gameId) &&
        canMemberWrite() &&
        (existing().createdBy == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Collection: /reviews/{reviewId} (Friend Ratings & Critiques)
    // Deterministic ID: {gameId}_{authorId}
    // ---------------------------------------------------------
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().authorId == request.auth.uid &&
        reviewId == incoming().gameId + '_' + request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canMemberWrite() &&
        exists(/databases/$(database)/documents/games/$(incoming().gameId));
      allow update: if isSignedIn() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().gameId == existing().gameId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canMemberWrite() &&
        (
          (existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'score', 'ratingOnly', 'hasSpoiler', 'headline', 'body', 'platformPlayed', 'hoursPlayed',
              'authorName', 'authorPhotoURL', 'gameTitle', 'gameCoverUrl', 'updatedAt'
            ])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'score', 'ratingOnly', 'hasSpoiler', 'headline', 'body', 'platformPlayed', 'hoursPlayed',
              'gameTitle', 'gameCoverUrl', 'updatedAt'
            ]))
        );
      allow delete: if isSignedIn() &&
        isValidId(reviewId) &&
        canMemberWrite() &&
        (existing().authorId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Collection: /comments/{commentId} (Social Feed Comments)
    // ---------------------------------------------------------
    match /comments/{commentId} {
      allow get: if isValidId(commentId) && (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(commentId) &&
        isValidComment(incoming()) &&
        incoming().createdAt == request.time &&
        canMemberWrite() &&
        exists(/databases/$(database)/documents/reviews/$(incoming().reviewId)) &&
        (!('parentCommentId' in incoming()) || (
          incoming().parentCommentId != commentId &&
          exists(/databases/$(database)/documents/comments/$(incoming().parentCommentId)) &&
          get(/databases/$(database)/documents/comments/$(incoming().parentCommentId)).data.reviewId == incoming().reviewId
        ));
      allow update: if false;
      allow delete: if isSignedIn() &&
        isValidId(commentId) &&
        canMemberWrite() &&
        (existing().authorId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Collection: /reactions/{reactionId} (Review Agreements)
    // Deterministic ID: {reviewId}_{userId}
    // ---------------------------------------------------------
    match /reactions/{reactionId} {
      allow get: if isValidId(reactionId) && (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(reactionId) &&
        isValidReaction(incoming()) &&
        reactionId == incoming().reviewId + '_' + request.auth.uid &&
        incoming().createdAt == request.time &&
        canMemberWrite() &&
        exists(/databases/$(database)/documents/reviews/$(incoming().reviewId));
      allow update: if false;
      allow delete: if isSignedIn() &&
        isValidId(reactionId) &&
        canMemberWrite() &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Collection: /events/{eventId} (Awards & Voting Events)
    // ---------------------------------------------------------
    match /events/{eventId} {
      allow get: if isValidId(eventId) && (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(eventId) &&
        isValidEvent(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(eventId) &&
        isValidEvent(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'mode', 'deadlineAt', 'status', 'categories', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() &&
        isValidId(eventId) &&
        isAdmin();
    }

    // ---------------------------------------------------------
    // Collection: /eventVotes/{voteId} (Public Member Votes)
    // Deterministic ID: {eventId}_{categoryId}_{userId}
    // ---------------------------------------------------------
    match /eventVotes/{voteId} {
      allow get: if isValidId(voteId) && (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(voteId) &&
        isValidEventVote(incoming()) &&
        voteId == incoming().eventId + '_' + incoming().categoryId + '_' + request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canMemberWrite() &&
        exists(/databases/$(database)/documents/events/$(incoming().eventId)) &&
        get(/databases/$(database)/documents/events/$(incoming().eventId)).data.status == 'active';
      allow update: if isSignedIn() &&
        isValidId(voteId) &&
        isValidEventVote(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().eventId == existing().eventId &&
        incoming().categoryId == existing().categoryId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'nomineeId', 'nomineeTitle', 'userName', 'userPhotoURL', 'updatedAt'
        ]) &&
        canMemberWrite() &&
        get(/databases/$(database)/documents/events/$(existing().eventId)).data.status == 'active';
      allow delete: if isSignedIn() &&
        isValidId(voteId) &&
        canMemberWrite() &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            get(/databases/$(database)/documents/events/$(existing().eventId)).data.status == 'active'
          )
        );
    }

    // ---------------------------------------------------------
    // Collection: /coverReports/{reportId} (Incorrect Cover Reports)
    // Deterministic ID: {gameId}_{reporterId}
    // ---------------------------------------------------------
    match /coverReports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (resource == null || existing().visibility == 'group');
      allow list: if isSignedIn() && resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(reportId) &&
        isValidCoverReport(incoming()) &&
        incoming().reporterId == request.auth.uid &&
        reportId == incoming().gameId + '_' + request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canMemberWrite() &&
        exists(/databases/$(database)/documents/games/$(incoming().gameId));
      allow update: if isSignedIn() &&
        isValidId(reportId) &&
        isValidCoverReport(incoming()) &&
        incoming().gameId == existing().gameId &&
        incoming().reporterId == existing().reporterId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canMemberWrite() &&
        (
          (existing().reporterId == request.auth.uid &&
            incoming().status == 'open' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'note', 'status', 'gameTitle', 'gameCoverUrl', 'reporterName', 'reporterPhotoURL', 'updatedAt'
            ])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'updatedAt'
            ]))
        );
      allow delete: if isSignedIn() &&
        isValidId(reportId) &&
        isAdmin();
    }

    // ---------------------------------------------------------
    // Collection: /eventNominations/{nominationId} (1 Game per Member in Nominating Phase)
    // Deterministic ID: {eventId}_{userId}
    // ---------------------------------------------------------
    match /eventNominations/{nominationId} {
      allow get: if isValidId(nominationId) && (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(nominationId) &&
        isValidEventNomination(incoming()) &&
        nominationId == incoming().eventId + '_' + request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canMemberWrite() &&
        exists(/databases/$(database)/documents/events/$(incoming().eventId)) &&
        get(/databases/$(database)/documents/events/$(incoming().eventId)).data.status == 'nominating';
      allow update: if isSignedIn() &&
        isValidId(nominationId) &&
        isValidEventNomination(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().eventId == existing().eventId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'gameId', 'title', 'coverUrl', 'userName', 'userPhotoURL', 'updatedAt'
        ]) &&
        canMemberWrite() &&
        get(/databases/$(database)/documents/events/$(existing().eventId)).data.status == 'nominating';
      allow delete: if isSignedIn() &&
        isValidId(nominationId) &&
        canMemberWrite() &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            get(/databases/$(database)/documents/events/$(existing().eventId)).data.status == 'nominating'
          )
        );
    }

    // ---------------------------------------------------------
    // Collection: /userGameStatuses/{statusId} (Member Play Statuses)
    // Deterministic ID: {gameId}_{userId}
    // ---------------------------------------------------------
    match /userGameStatuses/{statusId} {
      allow get: if isValidId(statusId) && (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        isValidId(statusId) &&
        isValidUserGameStatus(incoming()) &&
        statusId == incoming().gameId + '_' + request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canMemberWrite() &&
        exists(/databases/$(database)/documents/games/$(incoming().gameId));
      allow update: if isSignedIn() &&
        isValidId(statusId) &&
        isValidUserGameStatus(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().gameId == existing().gameId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'userName', 'userPhotoURL', 'updatedAt'
        ]) &&
        canMemberWrite();
      allow delete: if isSignedIn() &&
        isValidId(statusId) &&
        canMemberWrite() &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Collection: /groupConfig/{configId} (Admin-Managed Group Settings)
    // ---------------------------------------------------------
    match /groupConfig/{configId} {
      allow get: if configId == 'featuredRound' &&
        (resource == null || existing().visibility == 'group');
      allow list: if resource.data.visibility == 'group';
      allow create: if isSignedIn() &&
        configId == 'featuredRound' &&
        isValidFeaturedRoundConfig(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        configId == 'featuredRound' &&
        isValidFeaturedRoundConfig(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'gameId', 'title', 'coverUrl', 'roundLabel', 'eventId', 'note',
          'pinnedBy', 'pinnedByName', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() &&
        configId == 'featuredRound' &&
        isAdmin();
    }
  }
}
